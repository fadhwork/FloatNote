{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FloatNote",
  "version": "1.1.0",
  "identifier": "com.fadhlihsani.floatnote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FloatNote",
        "url": "index.html",
        "width": 900,
        "height": 270,
        "minWidth": 320,
        "minHeight": 150,
        "center": true,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "FloatNote Settings",
        "url": "settings.html",
        "width": 620,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "fadhlihsani",
    "shortDescription": "Floating, click-through synced lyrics overlay",
    "copyright": "Copyright (c) 2026 fadhlihsani",
    "longDescription": "FloatNote shows synced lyrics for whatever you are playing in a floating, click-through overlay."
  }
}
